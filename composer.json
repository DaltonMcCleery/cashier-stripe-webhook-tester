{
  "name": "daltonmccleery/cashier-stripe-webhook-tester",
  "description": "Testing Stripe events and webhook handling locally without Ngrok.",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "cashier",
    "stripe",
    "webhooks",
    "events"
  ],
  "authors": [
    {
      "name": "Dalton McCleery",
      "homepage": "https://daltonmccleery.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "laravel/cashier": "^14.0|^15.0",
    "stripe/stripe-php": "^14.0|^15.0|^16.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "^2.30|^3.0",
    "pestphp/pest-plugin-faker": "^2.0|^3.0",
    "pestphp/pest-plugin-laravel": "^2.2|^3.0"
  },
  "autoload": {
    "psr-4": {
      "CashierStripeWebhookTester\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": false
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CashierStripeWebhookTester\\CashierStripeWebhookTesterServiceProvider"
      ]
    }
  }
}
